{
  "name": "@peterchijioke/omni-payout",
  "version": "1.0.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peterchijioke/omni-payout.git"
  },
  "homepage": "https://github.com/peterchijioke/omni-payout#readme",
  "bugs": {
    "url": "https://github.com/peterchijioke/omni-payout/issues"
  },
  "description": "Unified multi-rail marketplace payout and transfer engine bridging Stripe Connect (US/Europe) and Flutterwave / NIP bank transfers & Mobile Money (Africa).",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "payout",
    "stripe-connect",
    "flutterwave",
    "marketplace-transfers",
    "cross-border",
    "mobile-money",
    "nip-transfer",
    "instant-payout",
    "fintech"
  ],
  "author": "Peter Chukwu",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
